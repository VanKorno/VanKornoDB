root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true

# ===================================================================
# Kotlin
# ===================================================================
[*.{kt,kts}]
indent_style = space
indent_size = 4
ij_continuation_indent_size = 4
ij_kotlin_keep_indents_on_empty_lines = true

# Wrapping and Braces
ij_kotlin_align_multiline_parameters = false

# Imports
ij_kotlin_name_count_to_use_star_import = 7
ij_kotlin_name_count_to_use_star_import_for_members = 5

# ===================================================================
# Java
# ===================================================================
[*.java]
indent_style = space
indent_size = 4
ij_continuation_indent_size = 4
ij_java_keep_indents_on_empty_lines = true